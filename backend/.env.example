# --- Bright Data (required) ---
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=            # SERP API zone name (Google Lens + Shopping)
BRIGHTDATA_UNLOCKER_ZONE=        # Web Unlocker zone name (product pages)
# Only for local dev, so Lens gets the image bytes instead of an unreachable localhost URL:
BRIGHTDATA_CUSTOMER_ID=          # hl_xxxxxxxx
BRIGHTDATA_SERP_ZONE_PASSWORD=

DATABASE_URL=sqlite:///./styletrail.db
PUBLIC_BASE_URL=http://localhost:8000   # public URL of this API (Render sets it in render.yaml)
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_TOKEN=

# --- Optional: Claude describes the garment for extra text searches ---
LLM_PROVIDER=none                # none | anthropic | bedrock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
BEDROCK_MODEL=                   # Bedrock model / inference profile ID (vision-capable Claude)
AWS_REGION=ap-south-1

# --- Optional: CLIP embeddings (needs `pip install open_clip-torch torch`, ~2 GB RAM) ---
ENABLE_CLIP=0

# --- Optional: e-mail price-drop alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
